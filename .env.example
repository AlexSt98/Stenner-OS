# NEXUS — copy this file to .env and fill in your own key. Never commit .env
# (it's already in .gitignore) and never put this key in the frontend.

# Which provider NEXUS talks to. Only "gemini" is implemented in V1;
# "openai" and "anthropic" are scaffolded for later.
AI_PROVIDER=gemini

# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Reserved for future providers — no effect until OpenAIProvider/AnthropicProvider are implemented.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Port the small Express API (server/index.ts) listens on. Vite's dev server
# proxies /api requests here — see vite.config.ts.
NEXUS_SERVER_PORT=8787

# ── Supabase (cloud sync — separate from NEXUS/Gemini above) ──────────────
# Optional: STENNER OS runs fully local without these, exactly as before.
# When both are set, sign-in/cloud sync (src/components/auth/AuthGate.tsx)
# turns on. These are the PUBLIC anon key/URL — safe to ship to the browser
# by Supabase's own design (see src/lib/supabase/client.ts); real protection
# comes from Row Level Security (src/lib/supabase/schema.sql), not secrecy.
# Never put a service_role key here or in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
