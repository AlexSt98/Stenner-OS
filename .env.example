# NEXUS — copy this file to .env and fill in your own key. Never commit .env
# (it's already in .gitignore) and never put this key in the frontend.

# Which provider NEXUS talks to. "openai" is implemented and is the
# default — "anthropic" is still scaffolded for later. (Gemini was NEXUS's
# original provider; it has been fully removed in favor of OpenAI.)
AI_PROVIDER=openai

# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Reserved for a future provider — no effect until AnthropicProvider is implemented.
ANTHROPIC_API_KEY=

# Port the small Express API (server/index.ts) listens on. Vite's dev server
# proxies /api requests here — see vite.config.ts.
NEXUS_SERVER_PORT=8787

# ── Supabase ─────────────────────────────────────────────────────────────
# Find these under Project Settings → API in your Supabase dashboard.
# Real values live in .env locally (gitignored) and in the Vercel project's
# environment variables — never in this file, and never in the repo.
#
# The URL and anon key MUST keep the VITE_ prefix: Vite only exposes
# VITE_-prefixed vars to the browser bundle. They are safe there by design —
# every table is protected by row-level security.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# SECRET — bypasses RLS entirely. Server-side only (server/, scripts/).
# Never give it a VITE_ prefix and never import it from src/.
SUPABASE_SERVICE_ROLE_KEY=

# Marketing Lab's backend. Supabase is the default whenever the two VITE_
# vars above are set; this only exists to force the browser-only adapter,
# for working offline or against a database you would rather not touch.
# VITE_MARKETING_BACKEND=local
