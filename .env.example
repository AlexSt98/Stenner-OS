# NEXUS — copy this file to .env and fill in your own key. Never commit .env
# (it's already in .gitignore) and never put this key in the frontend.

# Which provider NEXUS talks to. "gemini" and "openai" are implemented —
# flip this to switch, no other code changes needed. "anthropic" is still
# scaffolded for later.
AI_PROVIDER=gemini

# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Reserved for a future provider — no effect until AnthropicProvider is implemented.
ANTHROPIC_API_KEY=

# Port the small Express API (server/index.ts) listens on. Vite's dev server
# proxies /api requests here — see vite.config.ts.
NEXUS_SERVER_PORT=8787
